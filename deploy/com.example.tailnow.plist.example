<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.tailnow</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/opt/node@24/bin/node</string><string>/absolute/path/to/TailNow/current/server.js</string></array>
  <key>WorkingDirectory</key><string>/absolute/path/to/TailNow/current</string>
  <key>EnvironmentVariables</key><dict><key>TAILNOW_CONFIG</key><string>/absolute/path/to/TailNow/tailnow.json</string><key>PORT</key><string>8080</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/absolute/path/to/TailNow/logs/server.log</string>
  <key>StandardErrorPath</key><string>/absolute/path/to/TailNow/logs/error.log</string>
</dict></plist>
